# Read-only Google Calendar settings. Do not commit real credentials or tokens.
DEFAULT_TIMEZONE=America/Toronto
# Comma-separated IDs. Run `python -m calendar_agent.google_calendars_demo` to discover them.
GOOGLE_CALENDAR_IDS=primary
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=.secrets/google-calendar-token.json
